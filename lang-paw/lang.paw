		(say_hello_world [])))

(fn void main[]
	(println "Hello World!"))

(fn Int add[Int Int]
	(let a Int/1)
	(let a Int/2)
	(+ a b))

(fn Int sub(Int Int)
	(let [a Int/1
		  b Int/2
		  ]
		(+ a b)))
